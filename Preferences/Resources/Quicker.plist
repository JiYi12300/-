<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<!-- Credentials -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Credentials</string>
			<key>footerText</key>
			<string>Push to your Quicker PC (V2 API). Enter your Quicker account email and the push code set in the member center. The notification text will be pasted into the active window on the target PC by default.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>detail</key>
			<string>PSDetailController</string>
			<key>defaults</key>
			<string>com.noahsaso.pusher</string>
			<key>PostNotification</key>
			<string>com.noahsaso.pusher/prefs</string>
			<key>key</key>
			<string>toUser</string>
			<key>service</key>
			<string>Quicker</string>
			<key>label</key>
			<string>Account Email:</string>
			<key>noAutoCorrect</key>
			<true/>
			<key>keyboardType</key>
			<string>UIKeyboardTypeEmailAddress</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>detail</key>
			<string>PSDetailController</string>
			<key>defaults</key>
			<string>com.noahsaso.pusher</string>
			<key>PostNotification</key>
			<string>com.noahsaso.pusher/prefs</string>
			<key>key</key>
			<string>code</string>
			<key>service</key>
			<string>Quicker</string>
			<key>label</key>
			<string>Push Code:</string>
			<key>noAutoCorrect</key>
			<true/>
		</dict>

		<!-- Options -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Options</string>
			<key>footerText</key>
			<string>Target Device: leave empty to push to the active PC, use * for all PCs, or enter a specific PC name (must be connected).

Operation: paste pastes the text into the active window, copy puts it on the clipboard, action runs a Quicker action (fill its name or ID below), open opens the URL, input simulates typing.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>detail</key>
			<string>PSDetailController</string>
			<key>defaults</key>
			<string>com.noahsaso.pusher</string>
			<key>PostNotification</key>
			<string>com.noahsaso.pusher/prefs</string>
			<key>key</key>
			<string>toDevice</string>
			<key>service</key>
			<string>Quicker</string>
			<key>label</key>
			<string>Target Device (optional):</string>
			<key>noAutoCorrect</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>default</key>
			<string>paste</string>
			<key>defaults</key>
			<string>com.noahsaso.pusher</string>
			<key>PostNotification</key>
			<string>com.noahsaso.pusher/prefs</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>key</key>
			<string>operation</string>
			<key>service</key>
			<string>Quicker</string>
			<key>validTitles</key>
			<array>
				<string>Paste</string>
				<string>Copy</string>
				<string>Run Action</string>
				<string>Open URL</string>
				<string>Type</string>
			</array>
			<key>validValues</key>
			<array>
				<string>paste</string>
				<string>copy</string>
				<string>action</string>
				<string>open</string>
				<string>input</string>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>detail</key>
			<string>PSDetailController</string>
			<key>defaults</key>
			<string>com.noahsaso.pusher</string>
			<key>PostNotification</key>
			<string>com.noahsaso.pusher/prefs</string>
			<key>key</key>
			<string>action</string>
			<key>service</key>
			<string>Quicker</string>
			<key>label</key>
			<string>Action Name/ID (optional):</string>
			<key>noAutoCorrect</key>
			<true/>
		</dict>

		<!-- App List -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Apps</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.noahsaso.pusher</string>
			<key>PostNotification</key>
			<string>com.noahsaso.pusher/prefs</string>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>key</key>
			<string>appListIsBlacklist</string>
			<key>service</key>
			<string>Quicker</string>
			<key>validTitles</key>
			<array>
				<string>Blacklist</string>
				<string>Whitelist</string>
			</array>
			<key>validValues</key>
			<array>
				<true/>
				<false/>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>detail</key>
			<string>NSPAppListController</string>
			<key>icon</key>
			<string>app_list</string>
			<key>label</key>
			<string>App List</string>
			<key>service</key>
			<string>Quicker</string>
			<key>useSearchBar</key>
			<true/>
			<key>alphabeticIndexingEnabled</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>App Customization</string>
			<key>icon</key>
			<string>app_list</string>
			<key>detail</key>
			<string>NSPCustomizeAppsController</string>
			<key>service</key>
			<string>Quicker</string>
		</dict>
	</array>
	<key>title</key>
	<string>Quicker</string>
</dict>
</plist>
